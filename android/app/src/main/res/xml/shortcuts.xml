<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutId="set_sky_lock_screen"
        android:shortcutLongLabel="@string/shortcut_lock_screen_long"
        android:shortcutShortLabel="@string/shortcut_lock_screen_short">
        <intent
            android:action="com.burlington.darkskies.SHORTCUT_SET_LOCK_SCREEN"
            android:targetClass="com.burlington.darkskies.NativeSkyShortcutActivity"
            android:targetPackage="com.burlington.darkskies" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutId="pin_sky_home_widget"
        android:shortcutLongLabel="@string/shortcut_pin_widget_long"
        android:shortcutShortLabel="@string/shortcut_pin_widget_short">
        <intent
            android:action="com.burlington.darkskies.SHORTCUT_PIN_HOME_WIDGET"
            android:targetClass="com.burlington.darkskies.NativeSkyShortcutActivity"
            android:targetPackage="com.burlington.darkskies" />
    </shortcut>
</shortcuts>
